# ==============================================================================
# ENVIRONMENT & CORE APIS
# ==============================================================================
NEXT_PUBLIC_NODE_ENV="development" # Runtime mode: development | production
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000" # Backend server API base URL

# ==============================================================================
# CACHE REVALIDATION
# ==============================================================================
REVALIDATE_SECRET="123456" # Shared secret to authenticate incoming cache revalidation requests from the dashboard

# ==============================================================================
# ANALYTICS & EVENT TRACKING
# ==============================================================================
NEXT_PUBLIC_TRACKING_API_URL="http://localhost:5001/api/v1/events" # Order/event tracking server endpoint
GTM_ID="" # Google Tag Manager container ID (optional, e.g. GTM-XXXXXXX)

# ==============================================================================
# LANDING PAGES
# ==============================================================================
SX21_PRODUCT_ID="sx21-magic-wireless-microphone-lis9f" # Product ID or slug for SX21 Wireless Microphone landing page